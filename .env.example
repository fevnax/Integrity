# Firebase Configuration (Frontend Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini API Key (Nutritional Analysis Engine)
VITE_GEMINI_API_KEY=

# Upstash Redis Cache (Server-Only: Do NOT add VITE_ prefix to prevent exposing token in browser)
UPSTASH_REDIS_URL=https://your-database.upstash.io
UPSTASH_REDIS_TOKEN=your-rest-token